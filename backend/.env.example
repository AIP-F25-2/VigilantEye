# Core application
APP_NAME=VigilantEye
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Database connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=vigilanteye_user
MYSQL_PASSWORD=vigilanteye_pass
MYSQL_DATABASE=vigilanteye

# Redis connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery task queue
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Storage configuration
STORAGE_BASE_PATH=./storage                            # Root directory for all stored assets
VIDEO_TTL_HOURS=2                                      # Hours before uploaded videos expire
PERSON_VECTOR_TTL_HOURS=2                              # Hours before person vectors expire
TICKET_AUTO_CLOSE_HOURS=2                              # Hours before inactive tickets auto-close
MAX_VIDEO_SIZE_MB=500                                  # Maximum upload size for a single video
SUPPORTED_VIDEO_FORMATS=mp4,avi,mov,mkv                # Allowed video extensions

# Storage quotas
USER_QUOTA_MAX_GB=10                                   # Per-user storage cap (enforced on upload)
SYSTEM_QUOTA_WARNING_PERCENTAGE=80                     # System-wide usage threshold for warnings

# Cleanup task configuration
CLEANUP_BATCH_SIZE=1000                                # Records processed per cleanup batch
CLEANUP_ENABLED=true                                   # Enable scheduled cleanup tasks

# Logging
LOG_LEVEL=INFO


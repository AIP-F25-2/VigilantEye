APP_NAME=VigilantEye
APP_VERSION=1.0.0

# Scene Analysis
SCENE_CONFIDENCE_THRESHOLD=0.7
BLIP2_MODEL_NAME=Salesforce/blip2-opt-2.7b
BLIP2_MAX_LENGTH=100
BLIP2_PROMPT="Describe the scene in one sentence highlighting environment, lighting, weather, and crowd."
USE_SCENE_FALLBACK=true

# Object Detection
OBJECT_DETECTION_CONFIDENCE=0.5
OBJECT_MIN_SIZE=30
MAX_OBJECTS_PER_FRAME=100
OBJECT_PERSON_IOU_THRESHOLD=0.1
OBJECT_PERSON_MAX_DISTANCE=100
DETECT_ALL_OBJECTS=false

# Speech-to-Text Configuration
WHISPER_MODEL_SIZE=base
TRANSCRIPTION_CONFIDENCE_THRESHOLD=0.7
ENABLE_NOISE_REDUCTION=true
ENABLE_SPEAKER_DIARIZATION=true
THREAT_KEYWORDS=gun,shoot,kill,bomb,help,fire,weapon,attack,knife,threat
PROFANITY_KEYWORDS=

# Audio Classification Configuration
AUDIO_CLASSIFICATION_CONFIDENCE=0.5
MAX_SOUNDS_PER_SEGMENT=5
YAMNET_MODEL_URL=https://tfhub.dev/google/yamnet/1

# LLM Analyzer Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
LLM_CONFIDENCE_THRESHOLD=0.7                           # Minimum confidence to flag as suspicious (0.0-1.0)
LLM_MAX_TOKENS=500                                     # Maximum tokens in LLM response
LLM_TEMPERATURE=0.3                                    # LLM temperature (0.0=deterministic, 1.0=creative)
LLM_TIMEOUT_SECONDS=30                                 # Maximum time for LLM inference
LLM_MAX_RETRIES=2                                      # Retries if JSON parsing fails
USE_CHAIN_OF_THOUGHT=true                              # Enable chain-of-thought reasoning
USE_FEW_SHOT_EXAMPLES=true                             # Include few-shot examples in prompt
ENABLE_RULE_BASED_FALLBACK=true                        # Use rule-based fallback if LLM fails

# Telegram Configuration
TELEGRAM_BOT_TOKEN=<your_bot_token>
TELEGRAM_WEBHOOK_SECRET=<your_webhook_secret>
TELEGRAM_ESCALATION_CHANNEL=<your_channel_id>
TELEGRAM_PRIMARY_CHANNEL=<your_primary_channel_id>                   # Primary alert channel (same as escalation for now)
TELEGRAM_RETRY_ATTEMPTS=3                              # Number of retry attempts for failed sends
TELEGRAM_RETRY_DELAY=2                                 # Initial retry delay in seconds (exponential backoff)
TELEGRAM_RATE_LIMIT_MAX=10                             # Maximum messages per minute
TELEGRAM_WEBHOOK_URL=                                  # Webhook URL (set via /set-webhook endpoint)

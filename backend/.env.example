# Application
APP_NAME=VigilantEye
APP_VERSION=1.0.0
FLASK_APP=src.app:create_app
FLASK_ENV=development
DEBUG=true

# Security (replace in production)
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000
BCRYPT_LOG_ROUNDS=12
RATE_LIMIT_LOGIN=5 per 15 minutes

# Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=vigilanteye_user
MYSQL_PASSWORD=vigilanteye_pass
MYSQL_DATABASE=vigilanteye
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_MAX_OVERFLOW=20

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Vector Store
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_COLLECTION_NAME=vigilanteye_vectors

# Celery
ENABLE_BEAT=false  # Enable when scheduled tasks are implemented
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage
STORAGE_BASE_PATH=./storage
VIDEO_TTL_HOURS=2
PERSON_VECTOR_TTL_HOURS=2
TICKET_AUTO_CLOSE_HOURS=2
MAX_VIDEO_SIZE_MB=500
SUPPORTED_VIDEO_FORMATS=mp4,avi,mov,mkv

# Video Processing
FRAME_EXTRACTION_INTERVAL=1.0
MAX_CONCURRENT_STREAMS=4
MOTION_DETECTION_THRESHOLD=0.3

# AI Models
MODELS_CACHE_PATH=./models_cache
AI_CONFIDENCE_THRESHOLD=0.7
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ESCALATION_CHANNEL=
TELEGRAM_RETRY_ATTEMPTS=3
TELEGRAM_RETRY_DELAY=2

# Ticket Management
TICKET_ESCALATION_TIMEOUT_MINUTES=15

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_FILE_MAX_BYTES=104857600
LOG_FILE_BACKUP_COUNT=10

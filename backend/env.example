# Cleanup Configuration
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_HOURS=24
PERSON_DATA_RETENTION_DAYS=30
EMBEDDING_DATA_RETENTION_DAYS=90
MEDIA_RETENTION_DAYS=60

# Storage Paths

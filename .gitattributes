# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text eol=lf
*.pyw text eol=lf

# Shell scripts
*.sh text eol=lf
*.ps1 text eol=crlf

# Configuration files
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Web files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Binary files
*.pb binary
*.caffemodel binary
*.pkl binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary


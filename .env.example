# VigilentEye Docker Compose Environment Configuration
# Copy this file to .env for local development
# For production, use .env.production

# Docker Compose Variables
COMPOSE_PROJECT_NAME=vigilanteye
COMPOSE_FILE=docker-compose.yml

# Backend Service Variables
BACKEND_PORT=5000
BACKEND_WORKERS=4
BACKEND_TIMEOUT=300

# Celery Service Variables
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_LOGLEVEL=info

# Nginx Service Variables
NGINX_PORT=80
NGINX_SSL_PORT=443
NGINX_CLIENT_MAX_BODY_SIZE=500M

# Database Variables
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=vigilanteye
MYSQL_USER=vigilanteye_user
MYSQL_PASSWORD=vigilanteye_pass

# Redis Variables
# Leave empty for development, set in production
REDIS_PASSWORD=

# ChromaDB Variables
CHROMADB_PERSISTENT=TRUE

# Ollama Variables
OLLAMA_MODEL=llama3.2:1b
